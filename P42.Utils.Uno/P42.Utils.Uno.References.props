<Project ToolsVersion="15.0">


  <!-- NEEDED FOR JSImport -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Platforms\Desktop\libNativeBeep.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <!-- SHARED ITEMS -->
  <ItemGroup>
    <PackageReference Condition=" $(Configuration) == 'Release' " Include="P42.Utils" />
    <ProjectReference Condition=" $(Configuration) == 'Debug' " Include="..\P42.Utils\P42.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="P42.Serilog.QuickLog" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="AsyncAwaitBestPractices" />
    <PackageReference Include="UAParser" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <!--
    <PackageReference Include="Xamarin.GooglePlayServices.Ads.Identifier" />
    -->
  </ItemGroup>
  <ItemGroup Condition="  $(TargetFramework.Contains('wasm'))">
    <!-- required to use Uno.Web.Http.CookieManager because not visible to library projects -->
    <PackageReference Include="Uno.WinUI.Runtime.Skia.WebAssembly.Browser" />
  </ItemGroup>
  <ItemGroup Condition=" '$(WindowsBaseOs)' == 'true' " >
    <!-- required to query Windows for installed fonts -->
    <PackageReference Include="Microsoft.PowerShell.SDK" />
  </ItemGroup>



  <!-- SHARED ITEMS -->


</Project>
